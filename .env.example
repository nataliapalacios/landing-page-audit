# Obligatoria: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Recomendada (gratis): Google Cloud → "PageSpeed Insights API" → Credenciales → Clave de API.
# Sin ella, la cuota pública suele devolver 429 y el reporte sale sin la sección de PageSpeed.
PAGESPEED_API_KEY=

# Opcional: auditorías por día por IP (default 5; 0 = sin límite). Pensado para una demo pública.
# RATE_LIMIT_PER_DAY=5

# Opcional: si la definís, la app pide este código antes de gastar créditos.
# Dejala vacía si querés que cualquiera (ej. un reclutador) pueda probar la demo.
ACCESS_CODE=

# Opcionales: modelo y esfuerzo de razonamiento (low | medium | high).
# Default: claude-sonnet-5-5 + low (~US$0.04-0.06 por audit).
# Para máxima calidad: CLAUDE_MODEL=claude-opus-5-5 y CLAUDE_EFFORT=medium (~US$0.15).
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=low
