# Required: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Recommended (free): Google Cloud → "PageSpeed Insights API" → Credentials → API key.
# Without it, the public quota often returns 429 and the report ships without the PageSpeed section.
PAGESPEED_API_KEY=

# Optional: audits per month per IP (default 3; 0 = unlimited). Meant for a public demo.
# RATE_LIMIT_PER_MONTH=3

# Recommended so the limit persists: Upstash Redis (free) from the Vercel Marketplace.
# Vercel injects these two variables when you connect it; locally you can leave them empty.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: if set, the app asks for this code before spending credits.
# Leave it empty if you want anyone (e.g. a recruiter) to be able to try the demo.
ACCESS_CODE=

# Optional: model and reasoning effort (low | medium | high).
# Default: claude-sonnet-5-5 + low (~US$0.04-0.06 per audit).
# For maximum quality: CLAUDE_MODEL=claude-opus-5-5 and CLAUDE_EFFORT=medium (~US$0.15).
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=low
