# Obligatoria: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Recomendada (gratis): Google Cloud → "PageSpeed Insights API" → Credenciales → Clave de API.
# Sin ella, la cuota pública suele devolver 429 y el reporte sale sin la sección de PageSpeed.
PAGESPEED_API_KEY=

# Opcional: si la definís, la app pide este código antes de gastar créditos (evita uso ajeno).
ACCESS_CODE=

# Opcionales: modelo y esfuerzo de razonamiento (low | medium | high).
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
